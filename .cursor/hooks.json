{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "command": ".cursor/hooks/route-subagent.py",
        "matcher": "Task",
        "timeout": 10
      }
    ],
    "beforeReadFile": [
      {
        "command": ".cursor/hooks/guard-read.py",
        "timeout": 10
      }
    ],
    "subagentStart": [
      {
        "command": ".cursor/hooks/log-subagent.py",
        "timeout": 10
      }
    ],
    "afterFileEdit": [
      {
        "command": ".cursor/hooks/rh_catalog_refresh.py",
        "timeout": 40
      },
      {
        "command": ".cursor/hooks/graph_freshness.py",
        "timeout": 90
      }
    ],
    "sessionStart": [
      {
        "command": ".cursor/hooks/graph_freshness.py",
        "timeout": 90
      }
    ]
  }
}
