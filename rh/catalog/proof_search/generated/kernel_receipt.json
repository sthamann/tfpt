      "name": "RH.gabor_primeSide_rational_criterion_iff_rh",
      "standard_only": true,
      "type": "(∀ (a ω : ℚ) (ha : 0 < ↑a),\n    0 ≤\n      RH.gaborPoleSide (RH.pureGaborTest (↑a) (↑ω) ha) - RH.gaborPrimeComb (RH.pureGaborTest (↑a) (↑ω) ha) +\n        RH.gaborArchSide (RH.pureGaborTest (↑a) (↑ω) ha)) ↔\n  RiemannHypothesis"
    },
